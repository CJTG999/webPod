{
  "name": "webpod",
  "productName": "webPod",
  "version": "1.1.0",
  "description": "Retro click-wheel music player",
  "main": "electron/main.js",
  "author": "webPod",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "vendor": "node scripts/vendor-offline.js",
    "predist": "node scripts/vendor-offline.js",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.webpod.player",
    "productName": "webPod",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["electron/**", "index.html", "webpod.html", "other/**", "tools/**", "assets/**", "vendor/**", "package.json"],
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false, "shortcutName": "webPod" }
  }
}
